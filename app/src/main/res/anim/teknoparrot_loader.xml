<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/accelerate_decelerate_interpolator"
    android:shareInterpolator="true">
    <scale android:duration="1100" android:fromXScale="0.96" android:fromYScale="0.96"
        android:pivotX="50%" android:pivotY="50%" android:repeatCount="infinite"
        android:repeatMode="reverse" android:toXScale="1.04" android:toYScale="1.04" />
    <alpha android:duration="1100" android:fromAlpha="0.82" android:repeatCount="infinite"
        android:repeatMode="reverse" android:toAlpha="1" />
</set>
