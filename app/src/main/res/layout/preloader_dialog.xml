<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:background="#F0151519"
    android:clickable="false"
    android:focusable="false">

    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal"
        android:layout_gravity="center">

        <ImageView
            android:id="@+id/TeknoParrotLoaderLogo"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/teknoparrot_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="TeknoParrot"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#F5F3FF" />

        <TextView
            android:id="@+id/TextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textSize="15sp"
            android:textColor="#B8B4C9" />

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="160dp"
            android:layout_height="3dp"
            android:layout_marginTop="22dp"
            android:indeterminate="true"
            android:indeterminateTint="#8B7CFF" />
    </LinearLayout>
</FrameLayout>
